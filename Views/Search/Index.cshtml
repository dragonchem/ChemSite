@model ChemSite.Models.SearchViewModel
@{
    string prefix = Model.IsNsfw ? "nsfwgallery" : "gallery";
    string baseUrl = $"/{prefix}/search";
    int totalPages = (int)Math.Ceiling((double)Model.TotalResults / Model.PageSize);
    ViewData["Title"] = "Search Gallery";

    // All tags in all visible sections
    var allVisibleTags = Model.TagsConfig.Sections
        .Where(s => !s.Nsfw || Model.IsNsfw)
        .SelectMany(s => s.Tags)
        .ToList();
    var filteredTags = Model.SelectedTags; // tags that are turned OFF
}

@if (Model.IsNsfw)
{
    <script>
        const nsfw = localStorage.getItem("NSFW") === 'true';
        if (!nsfw) { window.location.href = `/disclaimer?url=${encodeURI(window.location.pathname + window.location.search)}`; }
    </script>
}

<div class="flex min-vh-100 align-content-center">
    <div class="container p-3 align-middle max-vh-95 overflow-y-scroll rounded-4 shadow-lg">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <nav aria-label="breadcrumb" class="flex-grow-1">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/"><img src="~/art/Chem/emotes/chemHi.png" loading="lazy" /></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="/@prefix"><h1>Gallery</h1></a>
                    </li>
                    <li class="breadcrumb-item align-self-center">
                        <a>Search@(Model.IsNsfw ? " (NSFW)" : "")</a>
                    </li>
                </ol>
            </nav>
        </div>

        <form method="get" action="@baseUrl" id="search-form" class="mb-4">
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <input type="text" name="q" class="form-control" placeholder="Search name or description…"
                           value="@Model.Query" id="search-q" />
                </div>
                <div class="col-md-3">
                    <select name="artist" id="artist-select" class="form-select">
                        <option value="">All artists</option>
                        @foreach (var a in Model.AllArtists)
                        {
                            <option value="@a.Value" selected="@(Model.SelectedArtist == a.Value ? "selected" : null)">@a.Label</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="sort" id="sort-select" class="form-select">
                        <option value="date" selected="@(Model.Sort == "date" ? "selected" : null)">Newest</option>
                        <option value="oldest" selected="@(Model.Sort == "oldest" ? "selected" : null)">Oldest</option>
                        <option value="artist" selected="@(Model.Sort == "artist" ? "selected" : null)">Artist</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary w-100">Go</button>
                </div>
            </div>

            <div class="mb-2 d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="setAllTags(true)">All on</button>
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="setAllTags(false)">All off</button>
            </div>
            <div id="tag-filters">
                @foreach (var tagSection in Model.TagsConfig.Sections)
                {
                    if (tagSection.Nsfw && !Model.IsNsfw) { continue; }
                    <div class="mb-2 tag-section">
                        <span class="text-body me-2">@tagSection.Name:</span>
                        @foreach (var tag in tagSection.Tags)
                        {
                            bool isChecked = !filteredTags.Contains(tag);
                            <label class="me-3">
                                <input type="checkbox" class="tag-checkbox" data-tag="@tag" checked="@(isChecked ? "checked" : null)" />
                                @tag
                            </label>
                        }
                    </div>
                }
            </div>
            <input type="hidden" name="filteredtags" id="tags-hidden" value="@string.Join(",", filteredTags)" />
        </form>

        <p class="text-body mb-3">@Model.TotalResults result@(Model.TotalResults == 1 ? "" : "s")@(totalPages > 1 ? $" — page {Model.Page}/{totalPages}" : "")</p>

        <div class="row">
            @foreach (var result in Model.Results)
            {
                <a class="col-lg-2 col-md-3 col-6 mb-3" href="/@prefix/@result.Path">
                    <div class="card">
                        <div class="card-img-top overflow-hidden position-relative">
                            <img class="card-img-top" src="~/thumb/@result.ThumbUrl" loading="lazy" />
                            @if (!result.IsImage || result.Path.EndsWith(".gif", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="video-icon"><i class="fas fa-play"></i></div>
                            }
                            @if (result.Info.Pinned)
                            {
                                <div class="pin-icon"><i class="fas fa-thumbtack"></i></div>
                            }
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@result.Info.Name</h5>
                            <div class="artists">
                                @foreach (var artist in result.Info.ArtistsInfo)
                                {
                                    <div class="artist mt-1 d-flex flex-row">
                                        <img class="rounded-circle me-1" src="@artist.ProfilePicture" loading="lazy" />
                                        <span class="flex-grow-1 w-75 mt-1">@artist.Name</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </a>
            }
        </div>

        @if (totalPages > 1)
        {
            string tagParam = filteredTags.Count > 0 ? "&filteredtags=" + string.Join(",", filteredTags) : "";
            string qParam = !string.IsNullOrEmpty(Model.Query) ? $"&q={Uri.EscapeDataString(Model.Query)}" : "";
            string artistParam = !string.IsNullOrEmpty(Model.SelectedArtist) ? $"&artist={Uri.EscapeDataString(Model.SelectedArtist)}" : "";
            string baseParams = $"{qParam}{tagParam}{artistParam}&sort={Model.Sort}";

            <div class="pagination-wrap mt-3">
                <a class="page-arrow @(Model.Page == 1 ? "disabled" : "")" href="@baseUrl?page=@(Model.Page - 1)@baseParams">‹</a>
                <div class="page-center-viewport">
                    <ul class="pagination flex-nowrap mb-0">
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" href="@baseUrl?page=@p@baseParams">@p</a>
                            </li>
                        }
                    </ul>
                </div>
                <a class="page-arrow @(Model.Page == totalPages ? "disabled" : "")" href="@baseUrl?page=@(Model.Page + 1)@baseParams">›</a>
            </div>
        }
    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/tom-select@2/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/tom-select@2/dist/js/tom-select.complete.min.js"></script>
<script>
    new TomSelect('#artist-select', { allowEmptyOption: true });

    const form = document.getElementById('search-form');
    const allTagCheckboxes = Array.from(document.querySelectorAll('.tag-checkbox'));

    const tagsHidden = document.getElementById('tags-hidden');

    function submitWithTags() {
        const unchecked = allTagCheckboxes.filter(cb => !cb.checked);
        tagsHidden.value = unchecked.map(cb => cb.dataset.tag).join(',');
        form.submit();
    }

    function setAllTags(on) {
        allTagCheckboxes.forEach(cb => cb.checked = on);
        submitWithTags();
    }

    document.getElementById('artist-select').addEventListener('change', submitWithTags);
    document.getElementById('sort-select').addEventListener('change', submitWithTags);
    allTagCheckboxes.forEach(cb => cb.addEventListener('change', submitWithTags));

    document.getElementById('search-q').addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); submitWithTags(); }
    });

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        submitWithTags();
    });
</script>
