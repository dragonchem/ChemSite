<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta content="@ViewData["Description"]" property="og:description" />
    <meta content="@ViewData["Url"]" property="og:url" />
    @if(ViewData["Title"] != null)
    {
        <meta property="og:site_name" content="@((ViewData["Title"] as string).Split("-")[0].Trim())">
        var url = ViewData["URL"] as string;
        var isVideo = false;
        if (!string.IsNullOrEmpty(url))
        {
            var videoExtensions = new[] { ".MP4", ".MOV", ".WEBM" };
            var ext = System.IO.Path.GetExtension(url).ToUpper();
            isVideo = videoExtensions.Contains(ext);
        }
        var title = ViewData["Title"] as string;
        if (title.Split("-").Count() > 1)
        {
            title = title.Split("-")[1];
        }
        <meta content="@title" property="og:title" />
        @if (!isVideo)
        {
            <meta content="@ViewData["Image"]" property="og:image" />
            <meta property="twitter:card" content="summary_large_image" />
        }
        else
        {
            <meta property="og:type" content="video.other" />
            <meta property="og:video" content="https://dragon-chem.net/@((ViewData["Image"] as string).Substring(1).Replace("\\", "/"))" />
            <meta property="og:video:url" content="https://dragon-chem.net/@((ViewData["Image"] as string).Substring(1).Replace("\\", "/"))" />
            <meta property="og:video:secure_url" content="https://dragon-chem.net/@((ViewData["Image"] as string).Substring(1).Replace("\\", "/"))" />
            <meta property="og:video:type" content="video/mp4" />
            <meta property="og:video:height" content="1080" />
            <meta property="og:video:width" content="1920" />
            <meta property="og:image" content="@((ViewData["Image"] as string).Replace("/art/", "/ffmpeg/") + ".png")" />
        }
        <!-- Twitter -->
        <meta property="twitter:url" content="@ViewData["Url"]" />
        <meta property="twitter:title" content="@ViewData["Title"]" />
        <meta property="twitter:description" content="@ViewData["Description"]" />
        @if (!isVideo)
        {
            <meta content="@ViewData["Image"]" property="twitter:image" />
        }
        else
        {
            <meta property="twitter:image" content="@((ViewData["Image"] as string).Replace("/art/", "/ffmpeg/") + ".png")" />
            <meta content="@ViewData["Image"]" property="twitter:video:url" />
            <meta content="@ViewData["Image"]" property="twitter:video" />
        }
    }

    <meta content="#D5810E" data-react-helmet="true" name="theme-color" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ChemSite.styles.css" asp-append-version="true" />
    <script src="https://kit.fontawesome.com/42969dccfc.js" crossorigin="anonymous"></script>
</head>
<body>
    @RenderBody()
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
