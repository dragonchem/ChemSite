@model string
@switch (Model)
{
    case "bluesky": <i class="fa-brands fa-bluesky"></i> break;
    case "discord": <i class="fa-brands fa-discord"></i> break;
    case "twitter": <i class="fa-brands fa-twitter"></i> break;
    case "fiverr": <img src="/fiverr-icon.svg" class="me-1" /> break;
    case "telegram": <i class="fa-brands fa-telegram"></i> break;
    case "deviantart": <i class="fa-brands fa-deviantart"></i> break;
    case "instagram": <i class="fa-brands fa-instagram"></i> break;
    case "reddit": <i class="fa-brands fa-reddit"></i> break;
    case "website": <i class="fa-solid fa-globe"></i> break;
    case "itaku": <img src="/itaku.png" class="me-1" /> break;
    case "furaffinity": <img src="/fa.png" class="me-1" /> break;
    default: <i class="fa-solid fa-link"></i> break;
}
