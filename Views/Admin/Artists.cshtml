@model List<ChemSite.Models.ArtistInfo>
@{
    string galleryPrefix = ViewBag.GalleryPrefix as string ?? "gallery";
    ViewData["Title"] = "Artists";
}

<div class="flex min-vh-100 align-content-center">
    <div class="container p-3 rounded-4 shadow-lg">
        <div class="d-flex align-items-center mb-3">
            <h2 class="me-auto">Artists</h2>
            <a href="/@galleryPrefix/admin/artists/create" class="btn btn-success btn-sm">
                <i class="fas fa-plus me-1"></i>New Artist
            </a>
        </div>
        <div class="row">
            @foreach (var artist in Model)
            {
                <div class="col-md-4 col-sm-6 mb-3">
                    <div class="card h-100">
                        <div class="card-body d-flex align-items-center gap-2">
                            @if (!string.IsNullOrEmpty(artist.ProfilePicture))
                            {
                                <img src="@artist.ProfilePicture" class="rounded-circle" style="width:40px;height:40px;object-fit:cover" loading="lazy" />
                            }
                            <span class="flex-grow-1">@artist.Name</span>
                            <a href="/@galleryPrefix/admin/artists/@artist.FileName" class="btn btn-sm btn-outline-warning">
                                <i class="fas fa-pencil"></i>
                            </a>
                            <button class="btn btn-sm btn-outline-danger" onclick="confirmDeleteArtist('@artist.FileName')">
                                <i class="fas fa-trash"></i>
                            </button>
                            <form id="del-@artist.FileName" method="post" action="/@galleryPrefix/admin/artists/@artist.FileName/delete" class="d-none"></form>
                        </div>
                    </div>
                </div>
            }
        </div>
        <a href="/@galleryPrefix" class="btn btn-secondary mt-2">← Back to Gallery</a>
    </div>
</div>

<script>
    function confirmDeleteArtist(filename) {
        if (confirm(`Delete artist "${filename}"? This cannot be undone.`))
            document.getElementById('del-' + filename).submit();
    }
</script>
