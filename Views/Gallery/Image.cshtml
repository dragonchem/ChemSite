@model GalleryImageViewModel
@{
    ViewData["Title"] = "Chem's art gallery";
    if (Model.Image.ImageInfo != null)
    {
        ViewData["Title"] = $"Chem's art gallery - {Model.Image.ImageInfo.Name}";
    }
    else if (Model.Path.Split("/").Last() != "")
    {
        ViewData["Title"] = $"Chem's art gallery - {String.Join(" > ", Model.PathParts)}";
    }
    if (Model.Image.ImageInfo != null)
    {
        ViewData["Description"] = Model.Image.ImageInfo.Description.Replace("\n", " ");
    }
    else
    {
        ViewData["Title"] = $"Chem's art gallery - {String.Join(" > ", Model.PathParts)}";
    }
    ViewData["Url"] = $"/gallery/{Model.Path}";
    ViewData["Image"] = $"/art/{Model.Image.ImageUrl}";
    ViewData["Summary"] = "twitter:card";
}

<div class="flex min-vh-100 align-content-center">
    <div class="container p-3 align-middle max-vh-95 overflow-y-scroll rounded-4 shadow-lg">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="/">
                        <img src="~/art/Chem/emotes/chemHi.png" />
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="/gallery">
                        <h1>Gallery</h1>
                    </a>
                </li>
                @{
                    string fullPath = "";
                    @foreach (var part in Model.PathParts)
                    {
                        if (part != "")
                        {
                            fullPath += $"{part}";
                            <li class="breadcrumb-item align-self-center">
                                @if (Model.PathParts.Last() == part)
                                {
                                    <a>
                                        @part
                                    </a>
                                }
                                else
                                {
                                    <a href="/gallery/@fullPath">
                                        @part
                                    </a>
                                }
                            </li>
                            fullPath += "/";
                        }
                    }
                }
            </ol>
        </nav>

        <div class="d-flex w-100 flex-column flex-lg-row">
            <div class="col-xs-12 flex-grow-1">
                @if (Model.Image.ImageInfo != null)
                {
                    <div class="flex-row">
                        <div class="d-flex">
                            <h2>
                                @Model.Image.ImageInfo.Name
                            </h2>
                            <span class="ms-3 mt-2 text-secondary align-middle">
                                Created on
                                @Model.Image.ImageInfo.CreationDate.ToString("yyyy-MM-dd")
                            </span>
                        </div>

                        <div>
                            @Html.Raw(Model.Image.ImageInfo.Description.Replace("\n", "<br />"))
                        </div>
                    </div>
                }
                else if (Model.Path.Split("/").Last() != "")
                {
                    <h2>
                        @Model.Path.Split("/").Last()
                    </h2>
                }
                else
                {
                    <h2>
                        Gallery
                    </h2>
                }

                <div class="image-detail d-flex container shadow-lg rounded-3 section p-3 mt-3">
                    @if (Model.Image.Image)
                    {
                        <a href="/art/@Model.Image.ImageUrl" class="w-100" target="_blank">
                            <img src="~/art/@Model.Image.ImageUrl" />
                        </a>
                    }
                    else
                    {
                        <a class="w-100">
                            <video loop controls autoplay src="~/art/@Model.Image.ImageUrl"></video>
                        </a>
                    }
                </div>
            </div>

            @if (Model.Image.ImageInfo != null)
            {
                <div class="artists px-4 mt-3">
                    Made by:
                    @foreach (var artist in Model.Image.ImageInfo.ArtistsInfo)
                    {
                        <div class="artist mt-2">
                            <div class="d-flex flex-row">
                                <img class="rounded-circle me-1" src="@artist.ProfilePicture" />
                                <span class="flex-row-1 mt-1">@artist.Name</span>
                            </div>

                            @foreach (var platform in artist.PlatformInfo)
                            {
                                <div class="ms-4 mt-1 @platform.Icon">
                                    @if (platform.Link == null || platform.Link == "")
                                    {
                                        <a class="d-flex flex-row-reverse artist-link" target="_blank">
                                            <span class="flex-grow-1">@platform.Name</span>
                                            @switch (platform.Icon)
                                            {
                                                case "bluesky":
                                                    <i class="fa-brands fa-bluesky"></i>
                                                    break;
                                                case "discord":
                                                    <i class="fa-brands fa-discord"></i>
                                                    break;
                                                case "twitter":
                                                    <i class="fa-brands fa-twitter"></i>
                                                    break;
                                                case "fiverr":
                                                    <img src="/fiverr-icon.svg" class="me-1" />
                                                    break;
                                                case "telegram":
                                                    <i class="fa-brands fa-telegram"></i>
                                                    break;
                                                case "deviantart":
                                                    <i class="fa-brands fa-deviantart"></i>
                                                    break;
                                                case "instagram":
                                                    <i class="fa-brands fa-instagram"></i>
                                                    break;
                                                case "reddit":
                                                    <i class="fa-brands fa-reddit"></i>
                                                    break;
                                                case "website":
                                                    <i class="fa-solid fa-globe"></i>
                                                    break;
                                                case "itaku":
                                                    <img src="/itaku.png" class="me-1" />
                                                    break;
                                                case "furaffinity":
                                                    <img src="/fa.png" class="me-1" />
                                                    break;
                                            }
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@platform.Link" class="d-flex flex-row-reverse artist-link" target="_blank">
                                            <span class="flex-grow-1">@platform.Name</span>
                                            @switch (platform.Icon)
                                            {
                                                case "bluesky":
                                                    <i class="fa-brands fa-bluesky"></i>
                                                    break;
                                                case "discord":
                                                    <i class="fa-brands fa-discord"></i>
                                                    break;
                                                case "twitter":
                                                    <i class="fa-brands fa-twitter"></i>
                                                    break;
                                                case "fiverr":
                                                    <img src="/fiverr-icon.svg" class="me-1" />
                                                    break;
                                                case "telegram":
                                                    <i class="fa-brands fa-telegram"></i>
                                                    break;
                                                case "deviantart":
                                                    <i class="fa-brands fa-deviantart"></i>
                                                    break;
                                                case "instagram":
                                                    <i class="fa-brands fa-instagram"></i>
                                                    break;
                                                case "reddit":
                                                    <i class="fa-brands fa-reddit"></i>
                                                    break;
                                                case "website":
                                                    <i class="fa-solid fa-globe"></i>
                                                    break;
                                                case "itaku":
                                                    <img src="/itaku.png" class="me-1" />
                                                    break;
                                                case "furaffinity":
                                                    <img src="/fa.png" class="me-1" />
                                                    break;
                                            }
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (Model.Image.ImageInfo.AltInfo.Count > 0)
                    {
                        <br />
                        <span>Alts:</span>
                        @foreach (var alt in Model.Image.ImageInfo.AltInfo)
                        {
                            <div class="ms-4 artist">
                                <a href="/gallery/@alt.Path" class="d-flex flex-row-reverse artist-link" target="_blank">
                                    <span class="flex-grow-1">@alt.Name</span>
                                    <i class="fa-solid fa-image"></i>
                                </a>
                            </div>
                        }
                    }

                    @if (Model.Image.ImageInfo.ExternalLinks.Length > 0)
                    {
                        <br />
                        <span>External links:</span>
                        @foreach (var platform in Model.Image.ImageInfo.ExternalLinks)
                        {
                            <div class="ms-4 @platform.Icon external-platform">
                                @if (platform.Link == null || platform.Link == "")
                                {
                                    <a class="d-flex flex-row-reverse" target="_blank">
                                        <span class="flex-grow-1">@platform.Name</span>
                                        @switch (platform.Icon)
                                        {
                                            case "bluesky":
                                                <i class="fa-brands fa-bluesky"></i>
                                                break;
                                            case "discord":
                                                <i class="fa-brands fa-discord"></i>
                                                break;
                                            case "twitter":
                                                <i class="fa-brands fa-twitter"></i>
                                                break;
                                            case "fiverr":
                                                <img src="/fiverr-icon.svg" class="me-1" />
                                                break;
                                            case "telegram":
                                                <i class="fa-brands fa-telegram"></i>
                                                break;
                                            case "deviantart":
                                                <i class="fa-brands fa-deviantart"></i>
                                                break;
                                            case "instagram":
                                                <i class="fa-brands fa-instagram"></i>
                                                break;
                                            case "reddit":
                                                <i class="fa-brands fa-reddit"></i>
                                                break;
                                            case "website":
                                                <i class="fa-solid fa-globe"></i>
                                                break;
                                            case "itaku":
                                                <img src="/itaku.png" class="me-1" />
                                                break;
                                            case "furaffinity":
                                                <img src="/fa.png" class="me-1" />
                                                break;
                                        }
                                    </a>
                                }
                                else
                                {
                                    <a href="@platform.Link" class="d-flex flex-row-reverse artist-link" target="_blank">
                                        <span class="flex-grow-1">@platform.Name</span>
                                        @switch (platform.Icon)
                                        {
                                            case "bluesky":
                                                <i class="fa-brands fa-bluesky"></i>
                                                break;
                                            case "discord":
                                                <i class="fa-brands fa-discord"></i>
                                                break;
                                            case "twitter":
                                                <i class="fa-brands fa-twitter"></i>
                                                break;
                                            case "fiverr":
                                                <img src="/fiverr-icon.svg" class="me-1" />
                                                break;
                                            case "telegram":
                                                <i class="fa-brands fa-telegram"></i>
                                                break;
                                            case "deviantart":
                                                <i class="fa-brands fa-deviantart"></i>
                                                break;
                                            case "instagram":
                                                <i class="fa-brands fa-instagram"></i>
                                                break;
                                            case "reddit":
                                                <i class="fa-brands fa-reddit"></i>
                                                break;
                                            case "website":
                                                <i class="fa-solid fa-globe"></i>
                                                break;
                                            case "itaku":
                                                <img src="/itaku.png" class="me-1" />
                                                break;
                                            case "furaffinity":
                                                <img src="/fa.png" class="me-1" />
                                                break;
                                        }
                                    </a>
                                }
                            </div>
                        }
                    }

                </div>
            }
        </div>

    </div>
</div>
